# Local-only development values. Copy this file to .env. Never use these on the public internet.
NODE_ENV=development
PORT=3000

MYSQL_DATABASE=brasa_delivery
MYSQL_USER=brasa
MYSQL_PASSWORD=brasa_dev_password
MYSQL_ROOT_PASSWORD=brasa_root_dev_password
MYSQL_PORT=3307
DATABASE_URL=mysql://brasa:brasa_dev_password@127.0.0.1:3307/brasa_delivery

# Local sign-in bypass works only while NODE_ENV=development. The app binds to loopback.
LOCAL_DEV_AUTH=true
LOCAL_DEV_ROLE=admin
LOCAL_DEV_NAME=Proprietario Local
LOCAL_DEV_EMAIL=dev@localhost
JWT_SECRET=local-only-change-me

# Optional WhatsApp Cloud API settings; leave blank to use the wa.me fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
APP_URL=http://localhost:3000
